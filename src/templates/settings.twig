{% import "_includes/forms" as forms %}

{% if lastError %}
    <div class="pane error" style="margin-bottom: 1rem;">
        <p>
            <strong>{{ "Last API error"|t('cleverreach') }}</strong>
            ({{ lastError.at|date('Y-m-d H:i') }}): {{ lastError.message }}
        </p>
    </div>
{% endif %}

<h2>{{ "OAuth-Zugangsdaten"|t('cleverreach') }}</h2>
<p class="light">{{ "Unter CleverReach: Account → Extras → REST API eine OAuth-App anlegen (Client Credentials Grant genügt). Client-ID/-Secret als Umgebungsvariablen hinterlegen, hier nur den Variablennamen eintragen."|t('cleverreach') }}</p>

{{ forms.textField({
    label: "OAuth Client-ID"|t('cleverreach'),
    instructions: "Name der Umgebungsvariable, z. B. $CLEVERREACH_CLIENT_ID"|t('cleverreach'),
    id: 'oauthClientId',
    name: 'oauthClientId',
    value: settings.oauthClientId,
    errors: settings.getErrors('oauthClientId'),
}) }}

{{ forms.textField({
    label: "OAuth Client-Secret"|t('cleverreach'),
    instructions: "Name der Umgebungsvariable, z. B. $CLEVERREACH_CLIENT_SECRET"|t('cleverreach'),
    id: 'oauthClientSecret',
    name: 'oauthClientSecret',
    value: settings.oauthClientSecret,
    errors: settings.getErrors('oauthClientSecret'),
}) }}

<div id="cleverreach-test" class="field">
    <button type="button" class="btn" id="cleverreach-test-run">{{ "Test connection"|t('cleverreach') }}</button>
    <span id="cleverreach-test-result" class="hidden" style="margin-left: 1rem;"></span>
</div>

{% js %}
(function () {
    // This template is always rendered through craft\base\Plugin::settingsHtml(),
    // which Craft core wraps in view.namespaceInputs(..., 'settings') --
    // every id/name/for in the HTML above becomes "settings-<original>".
    // getElementById() with the literal, unnamespaced string below would
    // silently find nothing and this handler would never attach; run the
    // same ids output above through |namespaceInputId so the JS always
    // matches whatever the HTML actually got rewritten to.
    const btn = document.getElementById({{ 'cleverreach-test-run'|namespaceInputId|json_encode|raw }});
    const result = document.getElementById({{ 'cleverreach-test-result'|namespaceInputId|json_encode|raw }});
    if (!btn || !result) return;

    btn.addEventListener('click', async () => {
        btn.setAttribute('disabled', 'disabled');
        result.classList.add('hidden');

        const body = new FormData();
        body.append(Craft.csrfTokenName, Craft.csrfTokenValue);

        try {
            const response = await fetch('{{ actionUrl('cleverreach/cp/test/run') }}', {
                method: 'POST',
                headers: { 'Accept': 'application/json' },
                body,
            });
            const data = await response.json();
            result.textContent = data.message;
            result.className = data.success ? 'success' : 'error';
        } catch (error) {
            result.textContent = String(error);
            result.className = 'error';
        } finally {
            btn.removeAttribute('disabled');
        }
    });
})();
{% endjs %}

<hr>

<h2>{{ "Listen & Formulare"|t('cleverreach') }}</h2>

{# CR-04: a picker fetched live from the connected account, instead of a
   raw numeric ID typed by hand. #}
<div class="field" id="cleverreach-groups-field">
    <div class="heading">
        <label for="defaultGroupId">{{ "Standard-Zielgruppe"|t('cleverreach') }}</label>
    </div>
    <div class="input ltr">
        <div class="flex">
            <select id="defaultGroupId" name="defaultGroupId" class="flex-grow">
                {% if settings.defaultGroupId %}
                    <option value="{{ settings.defaultGroupId }}" selected>{{ settings.defaultGroupId }}</option>
                {% else %}
                    <option value="">{{ "Keine ausgewählt"|t('cleverreach') }}</option>
                {% endif %}
            </select>
            <button type="button" class="btn" id="cleverreach-groups-refresh">{{ "Gruppen laden"|t('cleverreach') }}</button>
        </div>
    </div>
    <div class="instructions">
        <p>{{ "Gruppen werden mit dem konfigurierten Zugang live aus deinem CleverReach-Account geladen."|t('cleverreach') }}</p>
    </div>
    <span id="cleverreach-groups-result" class="hidden"></span>
    {% if settings.getErrors('defaultGroupId') %}
        <ul class="errors">
            {% for error in settings.getErrors('defaultGroupId') %}
                <li>{{ error }}</li>
            {% endfor %}
        </ul>
    {% endif %}
</div>

{% js %}
(function () {
    const select = document.getElementById({{ 'defaultGroupId'|namespaceInputId|json_encode|raw }});
    const refreshBtn = document.getElementById({{ 'cleverreach-groups-refresh'|namespaceInputId|json_encode|raw }});
    const result = document.getElementById({{ 'cleverreach-groups-result'|namespaceInputId|json_encode|raw }});
    if (!select || !refreshBtn) return;

    const selectedId = {{ settings.defaultGroupId|json_encode|raw }};

    async function loadGroups() {
        refreshBtn.setAttribute('disabled', 'disabled');
        result.classList.add('hidden');

        const body = new FormData();
        body.append(Craft.csrfTokenName, Craft.csrfTokenValue);

        try {
            const response = await fetch('{{ actionUrl('cleverreach/cp/groups/index') }}', {
                method: 'POST',
                headers: { 'Accept': 'application/json' },
                body,
            });
            const data = await response.json();

            if (!data.success) {
                result.textContent = data.message || 'Could not load groups.';
                result.className = 'error';
                return;
            }

            const current = select.value;
            select.innerHTML = '';

            const placeholder = document.createElement('option');
            placeholder.value = '';
            placeholder.textContent = '{{ "Keine ausgewählt"|t('cleverreach')|e('js') }}';
            select.appendChild(placeholder);

            for (const group of data.groups || []) {
                const option = document.createElement('option');
                option.value = group.id;
                option.textContent = `${group.name} (#${group.id})`;
                if (group.id === selectedId || group.id === current) {
                    option.selected = true;
                }
                select.appendChild(option);
            }

            result.textContent = '{{ "Gruppen geladen."|t('cleverreach') }}';
            result.className = 'success';
        } catch (error) {
            result.textContent = String(error);
            result.className = 'error';
        } finally {
            refreshBtn.removeAttribute('disabled');
        }
    }

    refreshBtn.addEventListener('click', loadGroups);
})();
{% endjs %}


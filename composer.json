{
    "name": "fipschen95/craft-cleverreach",
    "description": "DSGVO-konforme CleverReach-Newsletter-Integration für Craft CMS: Double-Opt-in-Anmeldung, Attribut-Sync und optionaler Craft-Commerce-Order-Push.",
    "type": "craft-plugin",
    "license": "MIT",
    "support": {
        "docs": "https://github.com/kernpfad/cleverreach",
        "issues": "https://github.com/kernpfad/cleverreach/issues"
    },
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "cleverreach",
        "newsletter",
        "email marketing"
    ],
    "require": {
        "php": "^8.1",
        "craftcms/cms": "^5.0.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "suggest": {
        "craftcms/commerce": "Erforderlich, um abgeschlossene Bestellungen an CleverReach zu pushen (Baustein C).",
        "verbb/formie": "Ermöglicht eine native Formie-Integration im Feld-Mapping-Editor, als Alternative zum generischen actions/cleverreach/subscribe/subscribe-Endpoint."
    },
    "autoload": {
        "psr-4": {
            "fipschen95\\cleverreach\\": "src/"
        }
    },
    "extra": {
        "handle": "cleverreach",
        "name": "CleverReach",
        "developer": "fipschen95",
        "documentationUrl": "https://github.com/kernpfad/cleverreach",
        "class": "fipschen95\\cleverreach\\Plugin",
        "changelogUrl": "https://raw.githubusercontent.com/kernpfad/cleverreach/main/CHANGELOG.md",
        "developerUrl": "https://kernpfad.dev",
        "imprintUrl": "https://kernpfad.dev/en/legal-notice",
        "privacyPolicyUrl": "https://kernpfad.dev/en/privacy-policy",
        "termsUrl": "https://kernpfad.dev/en/terms-and-conditions"
    }
}
